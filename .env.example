# ============================================================================
# AI Safety Helmet Detection - Environment Settings (template)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and edit the values. `.env` is gitignored.
# Keys must match the variable names in config.py (case-sensitive).
# Values are coerced to the type of the current default (bool/int/float/str).
# Lines starting with '#' are comments.
# ============================================================================

# --- Email / Supervisor Notification ---------------------------------------
EMAIL_ENABLED=True
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=True
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=aisafety@example.com
EMAIL_SUBJECT=🚨 AI Safety Violation Alert
EMAIL_MAX_RETRIES=1
EMAIL_TIMEOUT=30
EMAIL_IMAGE_QUALITY=95

# --- Database ---------------------------------------------------------------
DB_SEED_DEFAULTS=True
RULE_OVERRIDE_ENABLED=True
DEFAULT_SUPERVISOR_ID=

# --- Detection thresholds ---------------------------------------------------
CONFIDENCE_THRESHOLD=0.60
FRAME_SKIP=1
RESIZE_WIDTH=1280
VIOLATION_REQUIRED_FRAMES=30
HELMET_CONFIDENCE_THRESHOLD=0.90
HELMET_MIN_RATIO=0.45

# --- Camera defaults (used when no metadata is found) -----------------------
DEFAULT_CAMERA_NAME=None
DEFAULT_CAMERA_ID=None
DEFAULT_LOCATION=None

# --- Hikvision camera / live RTSP -------------------------------------------
# The camera login. Required to open the stream: Hikvision blocks anonymous
# RTSP by default. These stay on the server — they are never written to the
# database and never sent to the browser.
RTSP_USERNAME=admin
RTSP_PASSWORD=
# 101 = channel 1 main stream (full resolution), 102 = channel 1 sub stream
# (lower resolution, much lighter to decode — prefer it on a CPU-only host).
CAMERA_CHANNEL=101
RTSP_DEFAULT_PORT=554
# udp is faster but loses packets on a busy network, which reaches the detector
# as torn frames. Leave this on tcp unless you have a reason not to.
RTSP_TRANSPORT=tcp
# How long an unreachable camera may block a connect or a read.
RTSP_OPEN_TIMEOUT_MS=8000
RTSP_READ_TIMEOUT_MS=8000
RTSP_RECONNECT_ATTEMPTS=5
RTSP_RECONNECT_DELAY=3.0
RTSP_FALLBACK_FPS=15.0

# Registers this camera automatically at startup. Leave blank to add cameras
# from the dashboard instead.
CAMERA_IP=
CAMERA_ID=CAM001
CAMERA_NAME=Assembly Line 1
CAMERA_LOCATION=Production Area A

# --- Live analysis ----------------------------------------------------------
# 0 = a live session runs until it is stopped. Set a value in seconds to cap it.
LIVE_MAX_DURATION_SECONDS=0
# Each live session loads its own copy of the models — raise with care.
LIVE_MAX_SESSIONS=1

# --- NVA (Non-Value-Added) activity analysis --------------------------------
# Classifies what each tracked person is doing and charges the time to
# Value-Added / Necessary-NVA / NVA. Speeds and distances are in BODY-HEIGHTS
# (the person's own bounding-box height), never pixels, so one setting is
# correct at every distance from the camera.
NVA_ENABLED=True
# Below this speed (body-heights/second) a person counts as stationary; at or
# above the walk speed they are travelling rather than working in place.
NVA_IDLE_SPEED=0.08
NVA_WALK_SPEED=0.35
# Seconds an activity must hold before it is recorded. A brief pause is work
# rhythm, not waiting.
NVA_MIN_SEGMENT_SECONDS=3.0
NVA_IDLE_MIN_SECONDS=8.0
# Stationary people within this many body-heights of each other are recorded
# as one group huddle rather than separate idle individuals.
NVA_GROUP_PROXIMITY=1.5
# Value-added ratio (percent) the line is held to — drives the headline
# recommendation on the NVA Analysis page.
NVA_TARGET_VA_RATIO=60.0
# An activity below this share of classified time raises no recommendation.
NVA_RECOMMEND_MIN_SHARE=2.0

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
